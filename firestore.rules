rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Un utente autenticato senza profilo valido in /users NON ha alcun accesso
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return hasUserDoc() && getUserRole() == 'admin';
    }

    function isAdminOrDipendente() {
      return hasUserDoc() && getUserRole() in ['admin', 'dipendente'];
    }

    // ─── PROFILI UTENTE ─────────────────────────────────────────────────────────
    // I profili vengono creati/modificati solo dall'admin.
    // Ogni utente può leggere il proprio profilo e aggiornare solo lastLogin.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() && request.resource.data.role in ['admin', 'dipendente'];
      allow update: if isAdmin() || (
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
      );
      allow delete: if isAdmin();
    }

    // ─── CLIENTI ────────────────────────────────────────────────────────────────
    // Admin: accesso completo (inclusi dati fiscali, note, dichiarazione)
    // Dipendente: può leggere anagrafica base e creare nuovi clienti
    match /customers/{customerId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── PARTITE ────────────────────────────────────────────────────────────────
    // Entrambi: lettura e creazione
    // Solo Admin: eliminazione
    match /batches/{batchId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── PESATE ─────────────────────────────────────────────────────────────────
    match /weighings/{weighingId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── MOLITURA ───────────────────────────────────────────────────────────────
    match /millings/{millingId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── BINS ───────────────────────────────────────────────────────────────────
    match /bins/{binId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdminOrDipendente();
    }

    // ─── CONTENITORI OLIO ───────────────────────────────────────────────────────
    match /containers/{containerId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── PAGAMENTI (SOLO ADMIN) ─────────────────────────────────────────────────
    // Dati finanziari: visibili e modificabili solo dall'Admin
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── AGENDA ─────────────────────────────────────────────────────────────────
    // Admin e Dipendente: accesso completo (il dipendente non può eliminare)
    match /appointments/{appointmentId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── NOTIFICHE ──────────────────────────────────────────────────────────────
    // Tutti gli operatori autenticati possono leggere le notifiche e aggiornare isRead
    // Creazione aperta a tutti gli utenti per i trigger operativi
    // Solo Admin può cancellare le notifiche
    match /notifications/{notificationId} {
      allow read, create, update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }
  }
}
