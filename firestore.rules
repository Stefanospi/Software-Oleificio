rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return hasUserDoc() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'dipendente';
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isDipendente() {
      return isAuthenticated() && getUserRole() == 'dipendente';
    }

    function isAdminOrDipendente() {
      return isAuthenticated();
    }

    // ─── PROFILI UTENTE ─────────────────────────────────────────────────────────
    // Qualsiasi utente autenticato può leggere e gestire i profili (evita ricorsione con get())
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // ─── CLIENTI ────────────────────────────────────────────────────────────────
    // Admin: accesso completo (inclusi dati fiscali, note, dichiarazione)
    // Dipendente: può leggere anagrafica base e creare nuovi clienti
    match /customers/{customerId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── PARTITE ────────────────────────────────────────────────────────────────
    // Entrambi: lettura e creazione
    // Solo Admin: eliminazione
    match /batches/{batchId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── PESATE ─────────────────────────────────────────────────────────────────
    match /weighings/{weighingId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── MOLITURA ───────────────────────────────────────────────────────────────
    match /millings/{millingId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdminOrDipendente();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── BINS ───────────────────────────────────────────────────────────────────
    match /bins/{binId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdmin();
      allow update: if isAdminOrDipendente();
      allow delete: if isAdmin();
    }

    // ─── CONTENITORI OLIO ───────────────────────────────────────────────────────
    match /containers/{containerId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── PAGAMENTI (SOLO ADMIN) ─────────────────────────────────────────────────
    // Dati finanziari: visibili e modificabili solo dall'Admin
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── AGENDA ─────────────────────────────────────────────────────────────────
    // Admin: accesso completo
    // Dipendente: sola lettura
    match /appointments/{appointmentId} {
      allow read: if isAdminOrDipendente();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── NOTIFICHE ──────────────────────────────────────────────────────────────
    // Tutti gli operatori autenticati possono leggere le notifiche e aggiornare isRead
    // Creazione aperta a tutti gli utenti per i trigger operativi
    // Solo Admin può cancellare le notifiche
    match /notifications/{notificationId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
